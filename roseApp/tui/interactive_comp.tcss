/* Global reset for interactive dialogs */

Footer {
    margin-top: 1;
}

Hints {
    background: transparent;
    width: 100%;
    display: block;
    text-align: left;
}

/* --- PathInput --- */

PathInput {
    height: auto;
    width: 100%;
    background: $surface;
}

PathInput > Input {
    width: 100%;
    border: round $primary;
    padding: 0 1;
    background: $surface;
    height: auto;
    margin: 0;
}

PathInput > Input:focus {
    border: none;
    background: $surface;
    padding: 0;
    margin: 0;
}

PathInput > OptionList {
    height: auto;
    max-height: 10;
    width: 100%;
    display: none;
    background: $surface;
    border: none;
    margin-top: 0;
    padding: 0;
}

PathInput.show-suggestions > OptionList {
    display: block;
    border: round $primary;
    margin-top: 0;
}

/* When suggestions are shown, merge borders */
PathInput.show-suggestions > Input {
    border: none;
    height: auto;
}

PathInput > OptionList > .option-list--option-highlighted {
    background: $primary;
    color: $text;
    text-style: bold;
}

/* --- MultiSelection --- */

MultiSelection {
    width: 1fr;
    height: auto;
    padding: 0 1;
    background: $surface;
}

MultiSelection #message {
    margin-bottom: 1;
    color: $text-primary;
    text-style: bold;
}

MultiSelection > Input {
    margin-bottom: 1;
    border: none;
    height: 1;
    padding: 0;
    background: $surface;
}

MultiSelection > Input:focus {
    border: none;
}

/* MultiSelectionOption styles */
MultiSelectionOption {
    background: $surface;
    color: $text-muted;
}

MultiSelectionOption:hover {
    background: $boost;
}

MultiSelectionOption #cursor {
    width: 1;
    padding-right: 1;
    color: $accent;
    text-style: bold;
    display: block;
    visibility: hidden;
}

MultiSelectionOption.-active #cursor {
    visibility: visible;
}

MultiSelectionOption #status {
    width: 2;
    padding-right: 1;
}

MultiSelectionOption #label {
    width: 1fr;
}

MultiSelectionOption.-active {
    background: $primary;
    color: $text;
}

MultiSelectionOption.-active #cursor {
    /* Hide cursor if we use background highlight, or keep it? 
       User said "reference path_search", path_search usually doesn't have a cursor char.
       But MultiSelection implementation yields a cursor label.
       Let's keep it visible but maybe adjust color if needed.
       Actually, if background is primary (often orange), cursor (accent) might clash.
       Let's rely on background.
    */
    visibility: visible;
    color: $text;
}

MultiSelectionOption.-selected {
    color: $text-accent;
}

/* --- Question --- */

Question {
    width: 1fr;
    height: auto;
    padding: 0 1; 
    background: transparent;
}

Question #prompt {
    margin-bottom: 1;
    color: $text-primary;
}

Question.-blink Option.-active #caret {
    opacity: 0.2;
}

Question:blur #index,
Question:blur #caret {
    opacity: 0.3;
}

/* Question Option styles */
Option {
    background: transparent;
    color: $text-muted;
}

Option:hover {
    background: $boost;
}

Option #caret {
    visibility: hidden;
    padding: 0 1;
}

Option #index {
    padding-right: 1;
}

Option #label {
    width: 1fr;
}

Option.-active {            
    color: $text-accent;
}

Option.-active #caret {
    visibility: visible;
}

Option.-selected {
    opacity: 0.5;
}

Option.-active.-selected {
    opacity: 1.0;
    background: transparent;
    color: $text-accent;            
}

Option.-active.-selected #label {
    text-style: underline;
}

Option.-active.-selected #caret {
    visibility: hidden;
}
